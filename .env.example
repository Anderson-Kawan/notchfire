# Copie este arquivo para .env na raiz antes de subir em producao.
# Nunca use estes valores de exemplo em um servidor real.

COMPOSE_PROJECT_NAME=notchfire

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com,www.seu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://seu-dominio.com,https://www.seu-dominio.com
SITE_URL=https://seu-dominio.com

# SaaS multiempresa por dominio/subdominio
TENANT_BASE_DOMAINS=seu-dominio.com
TENANT_RESERVED_SUBDOMAINS=www,app,api,admin,static,media

# Banco PostgreSQL interno do Docker Compose
DB_ENGINE=postgresql
DB_CONN_MAX_AGE=60
DATABASE_URL=
POSTGRES_DB=notchfire
POSTGRES_USER=notchfire
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Proxy e HTTPS futuro
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_USE_X_FORWARDED_PORT=True
DJANGO_SECURE_PROXY_SSL_HEADER=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Arquivos e logs
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/
DJANGO_LOG_LEVEL=INFO

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Porta publicada pelo Nginx no servidor
NGINX_HTTP_PORT=80
